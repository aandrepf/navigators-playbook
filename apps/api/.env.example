# ── Playbook do Time — API ──────────────────────────────────────────────────
# Copie para `.env` e preencha. NUNCA commite `.env` (está no .gitignore).
# Em produção (Railway), defina estas variáveis no painel do serviço.

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=development          # development | test | production
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info                # trace | debug | info | warn | error | fatal | silent

# ── Postgres (Railway fornece esta var ao anexar o Postgres) ───────────────
DATABASE_URL=postgres://user:password@host:5432/playbook

# ── Sessão (cookie httpOnly/secure/sameSite=lax) ───────────────────────────
# TTL da sessão em dias (expiração deslizante).
SESSION_TTL_DAYS=30
# Força o flag `secure` do cookie (default: true em produção).
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_NAME=playbook_session

# ── Código de acesso por e-mail ────────────────────────────────────────────
OTP_TTL_MINUTES=10
OTP_LENGTH=6
OTP_RESEND_SECONDS=60

# ── Time e seed do primeiro head coach ─────────────────────────────────────
TEAM_NAME=Navigators
TEAM_CODE=NAVIGATORS          # código que o jogador digita no cadastro
SEED_HEAD_COACH_EMAIL=          # e-mail do head coach inicial (obrigatório no 1º deploy)
SEED_HEAD_COACH_NAME=Head Coach

# ── E-mail ─────────────────────────────────────────────────────────────────
# `console` imprime o código no log (dev/test); `smtp` envia de verdade.
MAILER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Playbook do Time <no-reply@playbook.local>

# ── Login com Google (OAuth) ───────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ── Frontend (origem de CORS e destino do callback do Google) ──────────────
FRONTEND_URL=http://localhost:5173
