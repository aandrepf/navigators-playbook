{
  "name": "navigators-playbook",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @playbook/web",
    "dev:api": "npm run dev -w @playbook/api --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch -w @playbook/web",
    "lint": "oxlint",
    "preview": "npm run preview -w @playbook/web",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "oxlint": "^1.90.0"
  }
}
